# シェル連携 none / detect / bash / elvish / fish / zsh
shell-integration = "zsh"

# テーマ $ ghostty +list-themes
theme = "iTerm2 Solarized Light"

# 非活性セルをわかりやすく
unfocused-split-opacity = 0.9
unfocused-split-fill = #000000

# フォント設定
font-family = "Menlo"
font-family = "BIZ UDGothic"
font-style = "Regular"
font-feature = "calt,liga"
font-size = 14.5
# 非Retina/FHDモニターで見やすくするために文字を少し太くする (macOSのみ)
font-thicken = true
font-thicken-strength = 100

# 背景の透明度
background-opacity = 1.0

# 背景のぼかし
background-blur = false

# ウィンドウ内の余白（ピクセル）
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true

# アプリケーションからの通知を許可
desktop-notifications = true

# 30秒以上かかったコマンドの完了を、非フォーカス時に通知
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

# アップデート
auto-update-channel = "stable"
auto-update = "check"

# macOS用タイトルバー設定 native / transparent / tabs / hidden)
macos-titlebar-style = "tabs"

# カーソル・マウス設定 block / bar / underline
cursor-style = "block"

# true: デフォルトで点滅、false: 点滅しない
cursor-style-blink = true

# タイピング中はマウスカーソルを非表示にする
mouse-hide-while-typing = true

# ウィンドウ外観  auto / system / light / dark / ghostty
window-theme = "system"

# 選択と同時にコピーしない true / false / clipboard
copy-on-select = false

# ウィンドウ状態（タブ・スプリット含む）を常に保存・復元する
window-save-state = "always"

# クイックターミナルを上部に表示
quick-terminal-position = "top"

# クイックターミナルを起動できるように
keybind = "global:cmd+shift+space=toggle_quick_terminal"

# フルスクリーンを無効化
keybind = "cmd+enter=unbind"

# タブの名前の自動更新をやめる
shell-integration-features = no-title
